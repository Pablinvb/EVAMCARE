# Entorno de ejecución: development, staging o production
DERMASCAN_ENV=development

# Dirección y puerto publicados por Docker Compose
DERMASCAN_HOST=0.0.0.0
DERMASCAN_PORT=8000

# Ruta persistente de SQLite dentro del contenedor
DERMASCAN_DATABASE_PATH=/app/data/dermascan.db

# Límites de carga y resolución
DERMASCAN_MAX_UPLOAD_MB=10
DERMASCAN_MAX_IMAGE_MEGAPIXELS=16

# Límite de análisis por sesión dentro de la ventana indicada
DERMASCAN_RATE_LIMIT_REQUESTS=20
DERMASCAN_RATE_LIMIT_WINDOW_SECONDS=600

# Orígenes permitidos, separados por comas
DERMASCAN_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Cambiar obligatoriamente en staging/producción
DERMASCAN_REFERRAL_TOKEN_SECRET=replace-with-a-long-random-secret
DERMASCAN_REFERRAL_TOKEN_TTL_SECONDS=3600
DERMASCAN_PARTNER_API_KEY=replace-with-a-private-partner-key

# First admin only; remove after verifying login. Never use real values here.
DERMASCAN_BOOTSTRAP_ADMIN_EMAIL=
DERMASCAN_BOOTSTRAP_ADMIN_PASSWORD=
# Recovery requires SMTP with mandatory STARTTLS (default port 587).
DERMASCAN_SMTP_HOST=
DERMASCAN_SMTP_PORT=587
DERMASCAN_SMTP_FROM=
DERMASCAN_SMTP_USER=
DERMASCAN_SMTP_PASSWORD=
DERMASCAN_RECOVERY_URL=https://pablinvb.github.io/EVAMCARE/
# Future Supabase provider: NOT enabled by setting these variables alone.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 only after restoring the verified persistent SQLite database.
DERMASCAN_REQUIRE_EXISTING_DATABASE=0
